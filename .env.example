# Copy to .env (cp .env.example .env). Used by local dev and Docker Compose.

# --- Postgres (docker compose) ---
POSTGRES_USER=downloader
POSTGRES_PASSWORD=downloader
POSTGRES_DB=downloader
POSTGRES_PORT=5432

# --- Server ---
DATABASE_URL=postgres://downloader:downloader@localhost:5432/downloader
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Signs download links. Use a long random value in production: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=dev-only-secret-change-me-0123456789abcdef
# Largest file the server will download (MB)
MAX_DOWNLOAD_MB=200
# Optional: send all outbound requests through a proxy
# HTTPS_PROXY=http://proxy.example.com:8080
