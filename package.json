{
  "name": "downloader-app",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @downloader/shared build && pnpm --parallel --recursive dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --parallel --recursive start",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
